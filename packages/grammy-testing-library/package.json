{
  "name": "grammy-testing-library",
  "version": "0.0.2",
  "type": "module",
  "homepage": "https://github.com/crutchcorn/grammy-testing-library#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crutchcorn/grammy-testing-library.git",
    "directory": "packages/grammy-testing-library"
  },
  "bugs": {
    "url": "https://github.com/crutchcorn/grammy-testing-library/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@grammyjs/types": "^5.0.0",
    "grammy": "^1.36.1",
    "grammy-markdown-v2-parser": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^5.0.0"
  },
  "devDependencies": {
    "@grammy-testing-library/config": "workspace:*",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "ts-morph": "^26.0.0",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.2",
    "vitest": "^5.1.0"
  }
}
